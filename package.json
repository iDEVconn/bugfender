{
  "name": "@idevconn/bugfender",
  "version": "0.3.0",
  "description": "Bugfender SDK helpers with built-in PII / noise filtering and typed tags. ~120 LOC. Framework-agnostic.",
  "license": "Apache-2.0",
  "author": "iDEVconn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iDEVconn/bugfender.git"
  },
  "bugs": {
    "url": "https://github.com/iDEVconn/bugfender/issues"
  },
  "homepage": "https://github.com/iDEVconn/bugfender#readme",
  "keywords": [
    "bugfender",
    "logging",
    "error-reporting",
    "pii",
    "observability"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@bugfender/sdk": ">=4.0.0"
  },
  "devDependencies": {
    "@bugfender/sdk": "^4.0.0",
    "@changesets/cli": "^2.31.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
